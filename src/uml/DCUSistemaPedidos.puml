@startuml
left to right direction

actor Usuario

rectangle "Sistema de gestion de Pedidos Ornelas"{
   usecase "Registro y consulta de información" as UC1
   usecase "Validacion de credenciales e identidad" as UC2
   usecase "Visualizacion y consulta del catalogo de productos activos" as UC3
   usecase "Creación y almacenamiento de solicitudes de compra" as UC4
   usecase "Consulta del historial de transacciones" as UC5
}
Usuario --> UC1
Usuario --> UC2
Usuario --> UC3
Usuario --> UC4
Usuario --> UC5
UC1 .> UC2 : <<include>>
UC4 .> UC2 : <<include>>

@enduml
